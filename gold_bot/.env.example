BOT_TOKEN=123456:ABC-your-token-from-BotFather
CHANNEL_ID=@your_channel
INTERVAL_MINUTES=10
CHANNEL_TITLE=قیمت لحظه‌ای طلای آنلاین
CHANNEL_HANDLE=@your_channel
# 1 = یک پیام ثابت را ویرایش کن، 0 = هر بار پیام جدید
EDIT_LAST_MESSAGE=0
ONLY_ON_CHANGE=1
# ساعت سکوت به وقت تهران، مثلاً 0-8
QUIET_HOURS=
# اگر سرور در ایران است و api.telegram.org بسته است:
# TELEGRAM_API_BASE=https://your-worker.your-name.workers.dev
# TELEGRAM_PROXY=socks5://user:pass@host:1080
# اگر سرور خارج از ایران است و سایت‌های طلا IP خارجی را می‌بندند:
# SCRAPE_PROXY=http://iran-proxy:8080
MIN_PRICE=1000000
MAX_PRICE=200000000
DB_PATH=data/goldbot.sqlite3
